# cp .env.example .env
#
# .env is gitignored. Never commit it, and never leave it on screen while
# filming (docs/07-safety-and-security.md).

# ----------------------------------------------------------------- server --
BRAIN_HOST=0.0.0.0
BRAIN_PORT=8765
BRAIN_PATH=/furby

# Must match BRAIN_TOKEN in firmware/include/secrets.h.
# Not real security on its own - LAN-only is the actual control.
BRAIN_TOKEN=change-me

# --------------------------------------------------------------------- stt --
# faster-whisper model: tiny.en | base.en | small.en | medium.en | large-v3
# small.en is the sweet spot on a 6 GB GPU.
STT_MODEL=small.en
STT_DEVICE=auto          # auto | cuda | cpu
STT_COMPUTE=float16      # float16 on GPU, int8 on CPU

# --------------------------------------------------------------------- llm --
LLM_BACKEND=ollama       # ollama | anthropic | openai

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Only needed when LLM_BACKEND is not ollama. Leave blank otherwise.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --------------------------------------------------------------------- tts --
TTS_BACKEND=piper        # piper | elevenlabs
PIPER_VOICE=en_GB-alba-medium
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ------------------------------------------------------------------- tools --
# OFF by default, on purpose. Read docs/07-safety-and-security.md before
# changing this. There is no raw-shell tool and there will not be one.
TOOLS_ENABLED=false

# Comma-separated allow-list. Empty means nothing is callable even when
# TOOLS_ENABLED is true.
TOOLS_ALLOW=time.now,timer.set

# Filesystem tools are confined to this directory. Anything resolving outside
# it is rejected before the tool runs.
TOOLS_SANDBOX=./sandbox

# Per-tool calls per minute.
TOOLS_RATE_LIMIT=6

# ----------------------------------------------------------------- privacy --
# Writes raw conversation audio to disk. Debugging only. Turn it back off.
SAVE_AUDIO=false
AUDIO_DIR=./recordings

LOG_LEVEL=INFO
